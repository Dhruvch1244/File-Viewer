<Window x:Class="FileViewer.App.Views.ExportDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sysconv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="Export" Height="500" Width="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="13">
    <Window.Resources>
        <sysconv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="EXPORT" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="DIF" GroupName="Format" IsChecked="{Binding IsDifSelected}" Margin="0,0,20,0" />
                <RadioButton Content="CSV" GroupName="Format" IsChecked="{Binding IsCsvSelected}" Margin="0,0,20,0" />
                <RadioButton Content="TSV" GroupName="Format" IsChecked="{Binding IsTsvSelected}" Margin="0,0,20,0" />
                <RadioButton Content="JSON" GroupName="Format" IsChecked="{Binding IsJsonSelected}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Date" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="130" Margin="0,0,20,0" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowDifFormatTokenChoice,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                        <RadioButton Content=".dif" GroupName="DifFormatToken" IsChecked="{Binding IsDifDotDifSelected}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <RadioButton Content=".out" GroupName="DifFormatToken" IsChecked="{Binding IsDifDotOutSelected}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,10,0,0" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="Saves as: " /><Run Text="{Binding SuggestedFileName, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="96" Style="{StaticResource ToolbarButtonStyle}" Click="OnCancelClick" Margin="0,0,8,0" />
            <Button Content="Export..." Width="110" Style="{StaticResource PrimaryButtonStyle}" Click="OnExportClick" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="PREVIEW — FIRST 2 ROWS" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                     BorderThickness="0" Background="Transparent" Padding="12"
                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>
    </DockPanel>
</Window>
