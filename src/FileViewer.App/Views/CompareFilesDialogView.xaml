<Window x:Class="FileViewer.App.Views.CompareFilesDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sysconv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:local="clr-namespace:FileViewer.App"
        Title="Compare Files" Height="480" Width="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="13">
    <Window.Resources>
        <sysconv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="COMPARE FILES" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

        <!-- No other section open yet: nothing to compare against. -->
        <TextBlock DockPanel.Dock="Top" Text="Open another file or section first — there's nothing to compare against yet."
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"
                   Visibility="{Binding HasNoTargets, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                Visibility="{Binding HasNoTargets, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="COMPARE AGAINST" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding CompareTargets}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedTarget}" Margin="0,0,0,16" />

                <TextBlock Text="MATCH ROWS BY (KEY COLUMN)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding KeyColumnOptions}" SelectedItem="{Binding SelectedKeyColumn}" />
                <TextBlock Text="Rows are matched by this column's value, not by position — so reordered rows aren't reported as changes."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Width="96" Style="{StaticResource ToolbarButtonStyle}" Click="OnCloseClick" Margin="0,0,8,0" />
                <Button Width="110" Click="OnCompareClick" IsEnabled="{Binding CanCompare}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Content" Value="Compare" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsComparing}" Value="True">
                                    <Setter Property="Content" Value="Comparing…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Result: counts, any reliability warning, and a button per non-empty category to open it
             as an ordinary extracted view — filterable, sortable, exportable, not a static report. -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Border Background="{DynamicResource PaleYellowBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,12"
                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Button Content="View added" Style="{StaticResource ToolbarButtonStyle}" Click="OnViewAddedClick"
                            IsEnabled="{Binding CanViewAdded}" Margin="0,0,8,0" />
                    <Button Content="View removed" Style="{StaticResource ToolbarButtonStyle}" Click="OnViewRemovedClick"
                            IsEnabled="{Binding CanViewRemoved}" Margin="0,0,8,0" />
                    <Button Content="View changed" Style="{StaticResource ToolbarButtonStyle}" Click="OnViewChangedClick"
                            IsEnabled="{Binding CanViewChanged}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
