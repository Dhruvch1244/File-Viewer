<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================== Dark palette ==============================
         Mirrors Colors.Light.xaml key-for-key. The accent carries the same Fidelity
         green identity as the light theme, tuned to a brighter emerald so it still
         reads clearly against a dark surface — with dark (not white) text on top of
         it, since the accent itself is light/saturated enough to need the contrast
         the other way around. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#242424" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9B9B98" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#111111" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#2FBB80" />
    <SolidColorBrush x:Key="AccentDarkHoverBrush" Color="#4FD69A" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#123047" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#565656" />

    <SolidColorBrush x:Key="PaleRedBrush" Color="#3A1F20" />
    <SolidColorBrush x:Key="PaleRedTextBrush" Color="#E5A0A0" />
    <SolidColorBrush x:Key="PaleBlueBrush" Color="#123047" />
    <SolidColorBrush x:Key="PaleBlueTextBrush" Color="#7FC4EE" />
    <SolidColorBrush x:Key="PaleGreenBrush" Color="#1E2E1E" />
    <SolidColorBrush x:Key="PaleGreenTextBrush" Color="#8FCB8F" />
    <SolidColorBrush x:Key="PaleYellowBrush" Color="#3A3218" />
    <SolidColorBrush x:Key="PaleYellowTextBrush" Color="#E0B25C" />

</ResourceDictionary>
