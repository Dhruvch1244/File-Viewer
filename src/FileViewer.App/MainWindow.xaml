<Window x:Class="FileViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileViewer.App"
        xmlns:sysconv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Bloomberg File Viewer" Icon="Assets/AppIcon.ico" Height="720" Width="1280"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="13"
        AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <sysconv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:FileNameConverter x:Key="FileNameConverter" />

        <DataTemplate x:Key="SelectAllHeaderTemplate">
            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                      Checked="OnSelectAllHeaderChecked" Unchecked="OnSelectAllHeaderUnchecked"
                      ToolTip="Select/clear all rows matching the current filter"
                      AutomationProperties.Name="Select all rows" />
        </DataTemplate>

        <DataTemplate x:Key="SelectCheckBoxCellTemplate">
            <!-- Bound directly to the row's own IsSelected (backed by RowSelectionState, not the
                 DataGrid's native per-page selection) so bulk selection survives paging. -->
            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="Select row" />
        </DataTemplate>

        <DataTemplate x:Key="ViewButtonCellTemplate">
            <!-- Minimal hand-drawn "eye" glyph (no icon font / emoji) — opens the record detail dialog. -->
            <Button Style="{StaticResource ToolbarButtonStyle}" Padding="2" ToolTip="View record"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnViewRecordClick">
                <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Path Data="M1,12 C1,12 5,4 12,4 C19,4 23,12 23,12 C23,12 19,20 12,20 C5,20 1,12 1,12 Z"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" />
                        <Ellipse Canvas.Left="9.25" Canvas.Top="9.25" Width="5.5" Height="5.5" Fill="{DynamicResource TextPrimaryBrush}" />
                    </Canvas>
                </Viewbox>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="DeleteButtonCellTemplate">
            <!-- Minimal hand-drawn "trash can" glyph — deletes this one record immediately, no checkbox/toolbar round-trip needed. -->
            <Button Style="{StaticResource ToolbarButtonStyle}" Padding="2" ToolTip="Delete this record"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnDeleteRowClick">
                <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Path Data="M5,7 L19,7 M9,7 L9,4 C9,3.4 9.4,3 10,3 L14,3 C14.6,3 15,3.4 15,4 L15,7"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="M6.5,7 L7.3,20 C7.35,20.6 7.85,21 8.4,21 L15.6,21 C16.15,21 16.65,20.6 16.7,20 L17.5,7"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <Line X1="10" Y1="10.5" X2="10.4" Y2="17.5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" />
                        <Line X1="14" Y1="10.5" X2="13.6" Y2="17.5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>
        </DataTemplate>

        <!-- The base DataGridCell/DataGridColumnHeader styles left-align their content (correct
             for text columns); the select-checkbox and view-button columns need their content
             centered instead, with tighter padding since they're narrow, fixed-width columns. -->
        <Style x:Key="CenteredCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,2" />
        </Style>
        <Style x:Key="CenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <!-- Data-column headers (not the fixed checkbox/view columns): use the menu icon to filter by value. -->
        <Style x:Key="DataColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="ToolTip" Value="Use the menu icon to filter by value." />
        </Style>

        <Style x:Key="FilterValueCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="4,3" />
        </Style>

        <!-- One open file in the tab strip: click the label to bring it forward, ✕ to close it. -->
        <DataTemplate x:Key="FileTabTemplate">
            <Border Margin="0,0,6,0" CornerRadius="6,6,0,0" BorderThickness="1,1,1,0" MouseDown="OnTabMouseDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="12,6" Click="OnFileTabClick"
                            ToolTip="{Binding FilePath}" AutomationProperties.Name="{Binding Title}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                            <TextBlock Text="{Binding SectionSummary}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMultipleSections}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Content="✕" FontSize="10" Padding="6,4" Margin="0,0,4,0" VerticalAlignment="Center"
                            Style="{StaticResource ToolbarButtonStyle}" ToolTip="Close this file"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One DATA= section of a bulk file. Sections are indexed the first time they're opened,
             so an unvisited one costs nothing until it's clicked. -->
        <DataTemplate x:Key="FileSectionTemplate">
            <Button Style="{StaticResource ToolbarButtonStyle}" Padding="12,5" Margin="0,0,6,0" Click="OnSectionChipClick"
                    ToolTip="{Binding ColumnCount, StringFormat='{}{0} column(s) in this section'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayLabel}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <DockPanel>

            <!-- ============================== Toolbar ============================== -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,10">
                    <Button DockPanel.Dock="Right" x:Name="ExportButton" Content="Export" Style="{StaticResource PrimaryButtonStyle}" Click="OnExportButtonClick" Margin="12,0,0,0" />
                    <Button DockPanel.Dock="Right" x:Name="OpenButton" Content="Open File" Style="{StaticResource PrimaryButtonStyle}" Click="OnOpenFileClick" ToolTip="Open a file (Ctrl+O) — or drop one onto the window" />
                    <Button DockPanel.Dock="Right" Content="New window" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0"
                            Click="OnNewWindowClick" ToolTip="Open a second window, for comparing files side by side" />
                    <Button DockPanel.Dock="Right" x:Name="RecentFilesButton" Content="Recent" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0"
                            Click="OnRecentFilesButtonClick" IsEnabled="{Binding HasRecentFiles}" ToolTip="Files you opened recently" />

                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}" Padding="8" Margin="0,0,12,0"
                            Command="{Binding ToggleThemeCommand}" ToolTip="Toggle light/dark theme"
                            AutomationProperties.Name="Toggle light/dark theme">
                        <Viewbox Width="16" Height="16">
                            <Grid Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Canvas.Style>
                                        <Style TargetType="Canvas">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Canvas.Style>
                                    <Ellipse Canvas.Left="7" Canvas.Top="7" Width="10" Height="10" Fill="{DynamicResource TextPrimaryBrush}" />
                                    <Line X1="12" Y1="0" X2="12" Y2="4" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="12" Y1="20" X2="12" Y2="24" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="0" Y1="12" X2="4" Y2="12" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="20" Y1="12" X2="24" Y2="12" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="3.5" Y1="3.5" X2="6.3" Y2="6.3" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="17.7" Y1="17.7" X2="20.5" Y2="20.5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="3.5" Y1="20.5" X2="6.3" Y2="17.7" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="17.7" Y1="6.3" X2="20.5" Y2="3.5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                                <Canvas Width="24" Height="24">
                                    <Canvas.Style>
                                        <Style TargetType="Canvas">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Canvas.Style>
                                    <Path Data="M20,14.5 A9,9 0 1 1 9.5,4 A7,7 0 0 0 20,14.5 Z" Fill="{DynamicResource TextPrimaryBrush}" />
                                </Canvas>
                            </Grid>
                        </Viewbox>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CanvasBrush}" CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.AddRowCommand}" />
                                <Button Content="Duplicate" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.DuplicateSelectedRowCommand}" />
                                <Button Content="Delete" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.DeleteSelectedRowsCommand}" />
                                <Button Content="Undo" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.UndoCommand}" ToolTip="Undo the last edit or row change (Ctrl+Z)" />
                                <Button Content="Extract" Style="{StaticResource ToolbarButtonStyle}" Click="OnExtractSelectionClick"
                                        ToolTip="Pull the selected rows into their own view — same file and columns, just those rows, with its own filters and sort" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Grid.SelectedCount, StringFormat='{}{0} selected'}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Grid.SelectedCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="12,4" />

                        <Border Background="{DynamicResource CanvasBrush}" CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ColumnsButton" Content="Columns" Style="{StaticResource ToolbarButtonStyle}" Click="OnColumnsButtonClick" />
                                <!-- Split button: Copy alone does the common thing (selected rows, with
                                     headers, tab-separated) so the default stays one click, and the caret
                                     holds the variants rather than making the toolbar carry four buttons. -->
                                <Button Content="Copy" Style="{StaticResource ToolbarButtonStyle}" Click="OnCopyClick"
                                        Padding="10,6,6,6"
                                        ToolTip="Copy the selected rows as tab-separated text (Ctrl+C) — pastes straight into Excel" />
                                <Button x:Name="CopyOptionsButton" Content="▾" Style="{StaticResource ToolbarButtonStyle}"
                                        Padding="4,6,8,6" FontSize="10" Click="OnCopyOptionsClick"
                                        AutomationProperties.Name="Copy options"
                                        ToolTip="Other ways to copy — without headers, as CSV, or every row in view" />
                                <Button x:Name="FileInfoButton" Content="File info" Style="{StaticResource ToolbarButtonStyle}" Click="OnFileInfoClick"
                                        ToolTip="Header metadata, section details and any parser warnings for this file" />
                            </StackPanel>
                        </Border>

                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="12,4" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="FROZEN COLUMNS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="34" Text="{Binding Grid.FrozenColumnCount, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================== Open files (tabs) ====================== -->
            <!-- Several files open at once, each with its own rows, edits, sort, filters and column
                 layout; the grid below always shows whichever tab is active. -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding HasFileOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="12,6,12,0">
                    <ItemsControl ItemsSource="{Binding Tabs}" ItemTemplate="{StaticResource FileTabTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ============================== Sections (bulk files) ================== -->
            <!-- Only shown for a file that declares more than one DATA= section. Each section is a
                 table in its own right (its own columns and rows) and is indexed the first time it
                 is opened, not when the file is. -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding ActiveTab.IsFromBulkFile, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <DockPanel Margin="16,8">
                    <!-- Names the shape of the file, not just "sections": a bulk delivery is several
                         whole exports in one file, each with its own columns, and that is worth saying
                         before someone wonders why the columns changed when they clicked a chip. -->
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ActiveTab.SectionBarLabel}" Style="{StaticResource SectionLabelStyle}"
                               Foreground="{DynamicResource AccentDarkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Content="Open all in tabs" Style="{StaticResource ToolbarButtonStyle}"
                            Padding="10,4" FontSize="12" Margin="10,0,0,0" Click="OnOpenAllSectionsInTabsClick"
                            Visibility="{Binding ActiveTab.HasMultipleSections, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                            ToolTip="Give every section its own tab, so they are all on screen at once instead of one click apart" />
                    <!-- A tab pinned to one section has no chips to show — the other sections are
                         other tabs now — but it still needs to say that it is part of a bulk file
                         and that these columns are this section's own. -->
                    <TextBlock Text="{Binding ActiveTab.PinnedSectionSummary}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding ActiveTab.IsPinnedToOneSection, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ActiveTab.HasMultipleSections, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <ItemsControl ItemsSource="{Binding ActiveTab.Sections}" ItemTemplate="{StaticResource FileSectionTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============================== Search bar ============================= -->
            <!-- One term at a time is typed here; "Find" searches with just that term, "+ Add term"
                 keeps the terms already applied and adds this one. Each term carries its own scope
                 (all columns, or one), comparison and case sensitivity, and the terms combine with
                 the match-all/match-any toggle. Every active term shows as a removable chip below.

                 Laid out as a WrapPanel, not a DockPanel: there are enough controls here that at a
                 normal window width a docked layout squeezed the dropdowns and the text box out of
                 view entirely. Wrapping puts them on a second line instead of clipping them, and the
                 widths below are minimums rather than fixed sizes so the row degrades gracefully. -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding HasFileOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <WrapPanel Orientation="Horizontal" Margin="16,8,16,4">
                    <TextBlock Text="SEARCH" Style="{StaticResource SectionLabelStyle}"
                               VerticalAlignment="Center" Margin="0,0,10,4" />

                    <ComboBox MinWidth="130" MaxWidth="190" VerticalAlignment="Center" Margin="0,0,6,4"
                              ItemsSource="{Binding Grid.SearchColumns}" SelectedItem="{Binding Grid.SearchColumn}"
                              ToolTip="Which column this term applies to" AutomationProperties.Name="Search scope" />
                    <ComboBox MinWidth="125" VerticalAlignment="Center" Margin="0,0,6,4"
                              ItemsSource="{Binding Grid.SearchModes}" SelectedItem="{Binding Grid.SearchMode}"
                              ToolTip="How this term is compared" AutomationProperties.Name="Search comparison" />

                    <Grid MinWidth="180" Width="230" VerticalAlignment="Center" Margin="0,0,6,4">
                        <TextBox x:Name="SearchTextBox"
                                 Text="{Binding Grid.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnSearchTextBoxKeyDown" AutomationProperties.Name="Search text" />
                        <TextBlock Text="Search…  (Ctrl+F)" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Grid.SearchText.Length}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" Margin="0,0,6,4"
                            Command="{Binding Grid.ApplySearchCommand}" Content="Find"
                            ToolTip="Search using only this term, replacing any terms already applied" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="10,6" Margin="0,0,6,4"
                            Command="{Binding Grid.AddSearchTermCommand}" Content="+ Add term"
                            ToolTip="Keep the terms already applied and add this one as well" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="8,6" Margin="0,0,10,4"
                            Command="{Binding Grid.ClearSearchCommand}" Content="✕" ToolTip="Clear the search" />

                    <CheckBox Content="Case" VerticalAlignment="Center" Margin="0,0,10,4"
                              IsChecked="{Binding Grid.SearchCaseSensitive}" ToolTip="Match upper/lower case exactly" />

                    <!-- Filter vs highlight: filtering hides what doesn't match, highlighting keeps
                         every row and marks the matching cells, with ‹ › to step between them. -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="10,6" Margin="0,0,6,4"
                            Click="OnToggleSearchModeClick" Content="{Binding Grid.SearchModeLabel}"
                            ToolTip="Switch between hiding rows that don't match and highlighting the ones that do" />

                    <!-- Combine mode: only meaningful once more than one term is applied. -->
                    <Button x:Name="CombineModeButton" Style="{StaticResource ToolbarButtonStyle}" Padding="10,6" Margin="0,0,6,4"
                            Click="OnToggleCombineModeClick" Content="{Binding Grid.SearchCombineLabel}"
                            ToolTip="Switch between requiring every term to match and requiring any one of them"
                            Visibility="{Binding Grid.HasMultipleSearchTerms, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4"
                                Visibility="{Binding Grid.HasHighlight, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding Grid.MatchLabel}" VerticalAlignment="Center" Margin="4,0,6,0"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="‹" Style="{StaticResource ToolbarButtonStyle}" Padding="8,6"
                                Command="{Binding Grid.PreviousMatchCommand}" ToolTip="Previous match (Shift+F3)" />
                        <Button Content="›" Style="{StaticResource ToolbarButtonStyle}" Padding="8,6"
                                Command="{Binding Grid.NextMatchCommand}" ToolTip="Next match (F3)" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- Matches the user cannot see: only the first twenty columns show by default, so a
                 highlight can report hundreds of matches over a screen with nothing marked on it. -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource PaleYellowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding Grid.HasHiddenMatches, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <DockPanel Margin="16,6">
                    <Button DockPanel.Dock="Right" Content="Show them" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12"
                            Click="OnShowHiddenMatchColumnsClick" />
                    <TextBlock Text="{Binding Grid.HiddenMatchesLabel}" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource PaleYellowTextBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- ============================== Active filters summary ================== -->
            <!-- "What am I filtering by" — every active search/column-value/column-pattern filter
                 as a removable chip, so it's never a mystery why fewer rows are showing. -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding Grid.HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <DockPanel Margin="16,8">
                    <TextBlock DockPanel.Dock="Left" Text="FILTERED BY" Style="{StaticResource SectionLabelStyle}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Content="Clear all" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12"
                            Command="{Binding Grid.ClearAllFiltersCommand}" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Grid.ActiveFilterChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="8,3" Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Button Content="✕" Command="{Binding RemoveCommand}" Margin="6,0,0,0"
                                                Style="{StaticResource ToolbarButtonStyle}" Padding="2,0" FontSize="10"
                                                VerticalAlignment="Center" ToolTip="Remove this filter" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ============================== Status bar ============================= -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,10">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressBar Width="220" VerticalAlignment="Center" Minimum="0" Maximum="100"
                                     Value="{Binding IndexingProgressPercent, Mode=OneWay}" />
                        <Button Content="Cancel" Style="{StaticResource ToolbarButtonStyle}" Padding="8,3" FontSize="11" Margin="8,0,0,0"
                                Command="{Binding CancelIndexingCommand}" ToolTip="Stop opening this file" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================== Pagination bar ========================== -->
            <!-- "Rows per page" goes up to "All rows", which turns paging off entirely: the grid
                 realizes only the rows on screen and rows are read and decoded only when asked for,
                 so showing everything is a scroll, not a load. The page buttons hide themselves in
                 that mode rather than sitting there disabled. -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding HasFileOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel Margin="16,8">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Grid.RowRangeLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Filtering…" Margin="10,0,0,0" FontSize="12" FontStyle="Italic"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding Grid.IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                        <Button Content="Stop" Style="{StaticResource ToolbarButtonStyle}" Padding="8,3" FontSize="11" Margin="8,0,0,0"
                                Click="OnCancelFilterClick" ToolTip="Stop filtering and keep the rows currently shown"
                                Visibility="{Binding Grid.IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ROWS PER PAGE" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox MinWidth="128" VerticalAlignment="Center"
                                  ItemsSource="{Binding Grid.PageSizeOptions}" SelectedItem="{Binding Grid.SelectedPageSize}"
                                  ToolTip="How many rows to show at once. 'All rows' scrolls through the whole result set."
                                  AutomationProperties.Name="Rows per page" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Grid.IsPagingActive, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Button Content="«" Style="{StaticResource ToolbarButtonStyle}" Padding="10,6" ToolTip="First page"
                                Command="{Binding Grid.FirstPageCommand}" IsEnabled="{Binding Grid.CanGoToPreviousPage}" />
                        <Button Content="‹ Previous" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding Grid.PreviousPageCommand}" IsEnabled="{Binding Grid.CanGoToPreviousPage}" />
                        <TextBox x:Name="PageNumberBox" Width="60" Margin="8,0,0,0" VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center" Padding="6,5"
                                 Text="{Binding Grid.PageNumberText, Mode=OneWay}"
                                 KeyDown="OnPageNumberBoxKeyDown" LostFocus="OnPageNumberBoxLostFocus"
                                 ToolTip="Type a page number and press Enter" AutomationProperties.Name="Page number" />
                        <TextBlock Text="{Binding Grid.PageCount, StringFormat='of {0:N0}'}" VerticalAlignment="Center" Margin="8,0,8,0"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="Next ›" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding Grid.NextPageCommand}" IsEnabled="{Binding Grid.CanGoToNextPage}" />
                        <Button Content="»" Style="{StaticResource ToolbarButtonStyle}" Padding="10,6" ToolTip="Last page"
                                Command="{Binding Grid.LastPageCommand}" IsEnabled="{Binding Grid.CanGoToNextPage}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================== Grid / welcome screen ==================== -->
            <Grid>
            <!-- ColumnWidth/MinColumnWidth are set, and column virtualization is off, on purpose.
                 Only the three fixed columns (select/view/delete) carry an explicit Width; the data
                 columns are built in code-behind with none, so they fell back to auto-sizing. Column
                 virtualization realizes only the columns in view, so that auto-size measured against
                 cells that did not exist yet and settled at zero width — which takes the header with
                 it, so every data column disappeared and the grid looked empty. Rows are what there
                 are millions of and EnableRowVirtualization still handles those; at most
                 GridViewModel.DefaultVisibleColumnCount (20) columns are ever realized, so
                 virtualizing columns bought nothing to begin with. A concrete default width also
                 avoids re-measuring every realized row whenever the page changes. -->
            <DataGrid x:Name="RowsDataGrid"
                      Margin="16"
                      Visibility="{Binding HasFileOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                      ItemsSource="{Binding Grid.Rows}"
                      SelectedItem="{Binding Grid.SelectedRow, Mode=TwoWay}"
                      SizeChanged="OnRowsDataGridSizeChanged"
                      SelectionMode="Extended"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      CanUserSortColumns="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="False"
                      ColumnWidth="160"
                      MinColumnWidth="60"
                      RowHeight="28"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      AlternationCount="0"
                      HeadersVisibility="Column" />

            <!-- Welcome / tutorial screen — shown until a file is opened, so the app never presents an empty page with no orientation. -->
            <Border x:Name="WelcomePanel" Background="{DynamicResource CanvasBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFileOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,16,0,0" To="0,0,0,0" Duration="0:0:0.35">
                                    <ThicknessAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="Assets/AppIcon.ico" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,20"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Bloomberg File Viewer" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Open, browse, edit, and export Bloomberg DIF files — built for files up to 2 GB with instant, virtualized scrolling."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,10,0,28" />

                        <StackPanel Margin="0,0,0,28">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" Margin="2,7,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="Instant virtualized scrolling through millions of rows without loading the whole file into memory"
                                           FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" Margin="2,7,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="Inline cell editing, add/duplicate/delete rows, and full undo history"
                                           FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" Margin="2,7,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="Search with as many terms as you need — per column or across all of them, with contains/equals/starts-with/regex and match-all or match-any"
                                           FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" Margin="2,7,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="Several files open at once as tabs, each with its own edits, sort, filters and column layout"
                                           FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" Margin="2,7,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="Bulk files detected automatically — every DATA= section shows as its own table, indexed only when you open it"
                                           FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" Margin="2,7,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="Excel-style per-column value filters, straight from the values actually in the file"
                                           FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" Margin="2,7,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="Export to DIF, CSV, TSV, or JSON with a live preview"
                                           FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" Margin="2,7,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="Light and dark themes — toggle from the button in the top-right corner"
                                           FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <Button Content="Open a File" Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"
                                HorizontalAlignment="Center" Click="OnOpenFileClick" />

                        <TextBlock Text="Made by Dhruv Choudhary" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,28,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Transient confirmation, over the grid rather than in the status bar: a copy gives no
                 other feedback at all, and a grey line at the bottom of the window is not where
                 anyone is looking after pressing Ctrl+C. Fades itself out; see ShowToast. -->
            <Border x:Name="Toast" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32"
                    Background="{DynamicResource TextPrimaryBrush}" CornerRadius="8" Padding="18,10">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="20" ShadowDepth="3" Direction="270" />
                </Border.Effect>
                <TextBlock x:Name="ToastText" Foreground="{DynamicResource SurfaceBrush}" FontSize="12.5" FontWeight="SemiBold" />
            </Border>
            </Grid>
        </DockPanel>

        <!-- ============================== Column chooser ============================ -->
        <Popup x:Name="ColumnsPopup" PlacementTarget="{Binding ElementName=ColumnsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="OnPopupOpened">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" MaxHeight="420" Width="240" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="18" ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="COLUMNS" Style="{StaticResource SectionLabelStyle}" Margin="4,0,4,8" />
                    <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                             Text="{Binding Grid.ColumnSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Act on whatever the search box above currently shows — with no search text that's every column. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Select all" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Click="OnSelectAllColumnsClick" />
                        <Button Content="Hide all" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Click="OnHideAllColumnsClick" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Grid.Columns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" Margin="4,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <!-- ============================== File info ================================ -->
        <!-- What the file says about itself, plus anything the parser had to warn about. The
             warnings used to be a number in the status bar with no way to read them. -->
        <Popup x:Name="FileInfoPopup" PlacementTarget="{Binding ElementName=FileInfoButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="OnPopupOpened">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" MaxHeight="520" Width="460" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="18" ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FILE INFO" Style="{StaticResource SectionLabelStyle}" Margin="4,0,4,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="FileInfoList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" ToolTip="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="FileDiagnosticsHeading" Text="DIAGNOSTICS" Style="{StaticResource SectionLabelStyle}"
                                       Margin="4,14,4,6" Visibility="Collapsed" />
                            <ItemsControl x:Name="FileDiagnosticsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CanvasBrush}" CornerRadius="4" Padding="8,6" Margin="4,0,4,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Headline}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <!-- ============================== Recent files ============================= -->
        <Popup x:Name="RecentFilesPopup" PlacementTarget="{Binding ElementName=RecentFilesButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="OnPopupOpened">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MaxHeight="420" Width="420" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="18" ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="RECENT FILES" Style="{StaticResource SectionLabelStyle}" Margin="8,4,8,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- File name on top, full path underneath: several exports often share a
                                         name and differ only by folder or date. -->
                                    <Button Style="{StaticResource ToolbarButtonStyle}" HorizontalContentAlignment="Left" Padding="8,6"
                                            Click="OnRecentFileClick"
                                            Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <!-- ============================== Copy options ============================ -->
        <!-- Each entry names what lands on the clipboard, with the reason underneath, because
             "Copy as CSV" and "Copy without headers" are indistinguishable from the default until
             you have already pasted somewhere and looked. -->
        <Popup x:Name="CopyOptionsPopup" PlacementTarget="{Binding ElementName=CopyOptionsButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" Opened="OnPopupOpened">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="8" Width="300" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="18" ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="COPY" Style="{StaticResource SectionLabelStyle}" Margin="8,4,8,8" />

                    <Button Style="{StaticResource ToolbarButtonStyle}" HorizontalContentAlignment="Left" Padding="8,6"
                            Click="OnCopyDefaultMenuClick">
                        <StackPanel>
                            <TextBlock Text="Selected rows" FontSize="12.5" />
                            <TextBlock Text="With headers, tab-separated — what the Copy button does"
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}" HorizontalContentAlignment="Left" Padding="8,6"
                            Click="OnCopyWithoutHeadersMenuClick">
                        <StackPanel>
                            <TextBlock Text="Selected rows, no headers" FontSize="12.5" />
                            <TextBlock Text="Values only — for pasting under rows you already have"
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}" HorizontalContentAlignment="Left" Padding="8,6"
                            Click="OnCopyAsCsvMenuClick">
                        <StackPanel>
                            <TextBlock Text="Selected rows as CSV" FontSize="12.5" />
                            <TextBlock Text="Commas and quoting, the same as an exported .csv"
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,6" />

                    <Button Style="{StaticResource ToolbarButtonStyle}" HorizontalContentAlignment="Left" Padding="8,6"
                            Click="OnCopyAllRowsMenuClick">
                        <StackPanel>
                            <TextBlock Text="Every row in view" FontSize="12.5" />
                            <TextBlock Text="Everything the filters leave, across all pages — ticked or not"
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============================== Column menu (values / stats) ============= -->
        <!-- Two views of one column: the Excel-style value picker, and a summary of what the column
             actually holds — distinct count, blanks, extremes, and the numeric totals when the values
             are numbers. The summary answers "is this column worth filtering on" before you filter. -->
        <Popup x:Name="ColumnFilterPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" Opened="OnPopupOpened">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Width="268" MaxHeight="440" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="18" ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock x:Name="ColumnFilterTitle" DockPanel.Dock="Top" Style="{StaticResource SectionLabelStyle}"
                               Margin="4,0,4,8" TextTrimming="CharacterEllipsis" />

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="ColumnValuesModeButton" Content="Values" Style="{StaticResource ToolbarButtonStyle}"
                                Padding="10,4" FontSize="12" Click="OnColumnValuesModeClick" />
                        <Button x:Name="ColumnStatsModeButton" Content="Stats" Style="{StaticResource ToolbarButtonStyle}"
                                Padding="10,4" FontSize="12" Click="OnColumnStatsModeClick" />
                    </StackPanel>

                    <!-- Sorting and the per-column filter live here rather than on the header itself:
                         a header click is already how you resize and reorder, and this is where a
                         user goes looking for what a column can do. -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Sort A→Z" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Click="OnColumnSortAscendingClick" />
                            <Button Content="Sort Z→A" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Click="OnColumnSortDescendingClick" />
                            <!-- "Clear sort", not "Clear": there is a second Clear further down for the
                                 value ticks, and two unqualified Clears in one popup say nothing about
                                 which is which. -->
                            <Button Content="Clear sort" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Click="OnColumnClearSortClick"
                                    ToolTip="Back to file order" />
                        </StackPanel>

                        <!-- The two ways to filter one column are stacked with nothing saying so, which
                             reads as one confusing form. Each gets a heading, and the second says "or"
                             so the relationship between them is legible at a glance. -->
                        <TextBlock Text="MATCH BY TEXT" Style="{StaticResource SectionLabelStyle}" Margin="4,0,4,5" />
                        <Grid Margin="0,0,0,6">
                            <TextBox x:Name="ColumnPatternBox" KeyDown="OnColumnPatternBoxKeyDown"
                                     AutomationProperties.Name="Match this column by text"
                                     ToolTip="Show only rows whose value in this column matches. Press Enter to apply." />
                            <TextBlock Text="Contains…  (Enter to apply)" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=ColumnPatternBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ColumnPatternRegexBox" Content="Regex" VerticalAlignment="Center" FontSize="12"
                                      ToolTip="Treat the text above as a regular expression instead of a substring" />
                            <Button Content="Apply" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Margin="8,0,0,0" Click="OnColumnPatternApplyClick" />
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <DockPanel x:Name="ColumnValuesPanel">
                            <TextBlock DockPanel.Dock="Top" Text="OR PICK FROM VALUES" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,4,5" />
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBox x:Name="ColumnFilterSearchBox" TextChanged="OnColumnFilterSearchChanged"
                                         AutomationProperties.Name="Search values"
                                         ToolTip="Narrows the list below. Select all / Deselect all then apply to just what the search leaves showing." />
                                <TextBlock Text="Search values…" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=ColumnFilterSearchBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <!-- "Deselect all" rather than "Clear": it already unticked everything, but
                                 next to a "Clear sort" button "Clear" reads as "clear the filter", which
                                 is the opposite of what ticking nothing then applying does. Both buttons
                                 act on whatever the search above leaves showing, which is why they say so. -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Select all" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Click="OnColumnFilterSelectAllClick"
                                        ToolTip="Tick every value currently listed" />
                                <Button Content="Deselect all" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Click="OnColumnFilterClearClick"
                                        ToolTip="Untick every value currently listed" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Cancel" Style="{StaticResource ToolbarButtonStyle}" Padding="10,5" Click="OnColumnFilterCancelClick" Margin="0,0,8,0" />
                                <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}" Padding="14,5" Click="OnColumnFilterApplyClick" />
                            </StackPanel>
                            <!-- Shown from the moment the popup opens until the (background) distinct-value
                                 lookup finishes — the popup is fully open and interactive immediately, it
                                 just doesn't have values to show yet, instead of freezing until it does. -->
                            <TextBlock x:Name="ColumnFilterLoadingText" DockPanel.Dock="Top" Text="Loading values…" FontSize="12"
                                       FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,4,8" Visibility="Collapsed" />
                            <!-- Shown when the column has more distinct values than the lookup collects, so a
                                 partial list is never presented as the complete set. -->
                            <TextBlock x:Name="ColumnFilterTruncatedText" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11"
                                       Text="Showing the first values only — this column has too many distinct values to list them all. Use the search box above, or match by text instead."
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,4,8" Visibility="Collapsed" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ColumnFilterValuesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsSelected}" Style="{StaticResource FilterValueCheckBoxStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <DockPanel x:Name="ColumnStatsPanel" Visibility="Collapsed">
                            <TextBlock x:Name="ColumnStatsLoadingText" DockPanel.Dock="Top" Text="Summarizing column…" FontSize="12"
                                       FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,4,8" Visibility="Collapsed" />
                            <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="10.5" Margin="4,10,4,0"
                                       Text="Counted over the rows currently in view — filters included."
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ColumnStatsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
