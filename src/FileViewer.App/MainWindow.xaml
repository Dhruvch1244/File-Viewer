<Window x:Class="FileViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileViewer.App"
        xmlns:sysconv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Bloomberg File Viewer" Height="720" Width="1280"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13">
    <Window.Resources>
        <sysconv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <DataTemplate x:Key="SelectAllHeaderTemplate">
            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                      Checked="OnSelectAllHeaderChecked" Unchecked="OnSelectAllHeaderUnchecked"
                      ToolTip="Select/clear all rows on this page" />
        </DataTemplate>

        <DataTemplate x:Key="SelectCheckBoxCellTemplate">
            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected, Mode=TwoWay}" />
        </DataTemplate>

        <DataTemplate x:Key="ViewButtonCellTemplate">
            <Button Content="View" Style="{StaticResource ToolbarButtonStyle}" Padding="8,2" FontSize="11" Click="OnViewRecordClick" />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <DockPanel>

            <!-- ============================== Toolbar ============================== -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,10">
                    <Button DockPanel.Dock="Right" x:Name="ExportButton" Content="Export" Style="{StaticResource PrimaryButtonStyle}" Click="OnExportButtonClick" Margin="12,0,0,0" />
                    <Button DockPanel.Dock="Right" x:Name="OpenButton" Content="Open File" Style="{StaticResource PrimaryButtonStyle}" Click="OnOpenFileClick" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource CanvasBrush}" CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.AddRowCommand}" />
                                <Button Content="Duplicate" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.DuplicateSelectedRowCommand}" />
                                <Button Content="Delete" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.DeleteSelectedRowsCommand}" />
                                <Button Content="Undo" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.UndoCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,4" />

                        <Border Background="{StaticResource CanvasBrush}" CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ColumnsButton" Content="Columns" Style="{StaticResource ToolbarButtonStyle}" Click="OnColumnsButtonClick" />
                                <Button Content="Clear sort" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.ClearSortCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,4" />

                        <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="200" VerticalAlignment="Center">
                                    <TextBlock Text="Search all columns" Foreground="{StaticResource TextSecondaryBrush}" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Grid.SearchText.Length}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="SearchTextBox" BorderThickness="0" Background="Transparent"
                                             Text="{Binding Grid.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnSearchTextBoxKeyDown" />
                                </Grid>
                                <Button Content="Find" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.ApplySearchCommand}" />
                                <Button Content="✕" Style="{StaticResource ToolbarButtonStyle}" Padding="8,6" Command="{Binding Grid.ClearSearchCommand}" ToolTip="Clear search" />
                            </StackPanel>
                        </Border>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,4" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="FROZEN COLUMNS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="34" Text="{Binding Grid.FrozenColumnCount, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================== Status bar ============================= -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,10">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <ProgressBar Width="220" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding IndexingProgressPercent, Mode=OneWay}"
                                 Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <!-- ============================== Pagination bar ========================== -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,8">
                    <TextBlock Text="{Binding Grid.TotalRowCount, StringFormat='{}{0:N0} record(s)'}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="‹ Previous" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding Grid.PreviousPageCommand}" IsEnabled="{Binding Grid.CanGoToPreviousPage}" />
                        <TextBlock Text="{Binding Grid.PageLabel}" VerticalAlignment="Center" Margin="12,0"
                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Button Content="Next ›" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding Grid.NextPageCommand}" IsEnabled="{Binding Grid.CanGoToNextPage}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================== Grid ==================================== -->
            <DataGrid x:Name="RowsDataGrid"
                      Margin="16"
                      ItemsSource="{Binding Grid.Rows}"
                      SelectedItem="{Binding Grid.SelectedRow, Mode=TwoWay}"
                      SelectionChanged="OnGridSelectionChanged"
                      Sorting="OnDataGridSorting"
                      SelectionMode="Extended"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      CanUserSortColumns="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      RowHeight="28"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      AlternationCount="0"
                      HeadersVisibility="Column" />
        </DockPanel>

        <!-- ============================== Column chooser ============================ -->
        <Popup x:Name="ColumnsPopup" PlacementTarget="{Binding ElementName=ColumnsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" MaxHeight="420" Width="240" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="18" ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="COLUMNS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,4,8" />
                    <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                             Text="{Binding Grid.ColumnSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Grid.Columns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" Margin="4,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
