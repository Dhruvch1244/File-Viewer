<Window x:Class="FileViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileViewer.App"
        xmlns:sysconv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Bloomberg File Viewer" Height="720" Width="1280"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13">
    <Window.Resources>
        <sysconv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <DataTemplate x:Key="SelectAllHeaderTemplate">
            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                      Checked="OnSelectAllHeaderChecked" Unchecked="OnSelectAllHeaderUnchecked"
                      ToolTip="Select/clear all rows matching the current filter" />
        </DataTemplate>

        <DataTemplate x:Key="SelectCheckBoxCellTemplate">
            <!--
                DataGrid's own click-to-select logic also fires when you click this checkbox
                (they share the same routed mouse event), which was silently collapsing multi-row
                selection down to whatever row was clicked last — checking several rows and hitting
                Delete only ever affected the last one. PreviewMouseLeftButtonDown intercepts the
                click, toggles the box manually, and marks the event handled before DataGrid's own
                selection logic sees it, so checking multiple rows now actually accumulates.
            -->
            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected, Mode=TwoWay}"
                      PreviewMouseLeftButtonDown="OnRowCheckBoxPreviewMouseDown" />
        </DataTemplate>

        <DataTemplate x:Key="ViewButtonCellTemplate">
            <!-- Minimal hand-drawn "eye" glyph (no icon font / emoji) — opens the record detail dialog. -->
            <Button Style="{StaticResource ToolbarButtonStyle}" Padding="2" ToolTip="View record"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnViewRecordClick">
                <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Path Data="M1,12 C1,12 5,4 12,4 C19,4 23,12 23,12 C23,12 19,20 12,20 C5,20 1,12 1,12 Z"
                              Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" />
                        <Ellipse Canvas.Left="9.25" Canvas.Top="9.25" Width="5.5" Height="5.5" Fill="{StaticResource TextPrimaryBrush}" />
                    </Canvas>
                </Viewbox>
            </Button>
        </DataTemplate>

        <!-- The base DataGridCell/DataGridColumnHeader styles left-align their content (correct
             for text columns); the select-checkbox and view-button columns need their content
             centered instead, with tighter padding since they're narrow, fixed-width columns. -->
        <Style x:Key="CenteredCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,2" />
        </Style>
        <Style x:Key="CenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <!-- Data-column headers (not the fixed checkbox/view columns) get a hint that right-click opens the value filter, since there's no per-header icon for it. -->
        <Style x:Key="DataColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="ToolTip" Value="Click to filter by value. Double-click to sort." />
        </Style>

        <Style x:Key="FilterValueCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="4,3" />
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel>

            <!-- ============================== Toolbar ============================== -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,10">
                    <Button DockPanel.Dock="Right" x:Name="ExportButton" Content="Export" Style="{StaticResource PrimaryButtonStyle}" Click="OnExportButtonClick" Margin="12,0,0,0" />
                    <Button DockPanel.Dock="Right" x:Name="OpenButton" Content="Open File" Style="{StaticResource PrimaryButtonStyle}" Click="OnOpenFileClick" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource CanvasBrush}" CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.AddRowCommand}" />
                                <Button Content="Duplicate" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.DuplicateSelectedRowCommand}" />
                                <Button Content="Delete" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.DeleteSelectedRowsCommand}" />
                                <Button Content="Undo" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.UndoCommand}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Grid.SelectedRows.Count, StringFormat='{}{0} selected'}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Grid.SelectedRows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,4" />

                        <Border Background="{StaticResource CanvasBrush}" CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ColumnsButton" Content="Columns" Style="{StaticResource ToolbarButtonStyle}" Click="OnColumnsButtonClick" />
                                <Button Content="Clear sort" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.ClearSortCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,4" />

                        <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="200" VerticalAlignment="Center">
                                    <TextBlock Text="Search all columns" Foreground="{StaticResource TextSecondaryBrush}" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Grid.SearchText.Length}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="SearchTextBox" BorderThickness="0" Background="Transparent"
                                             Text="{Binding Grid.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnSearchTextBoxKeyDown" />
                                </Grid>
                                <Button Content="Find" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Grid.ApplySearchCommand}" />
                                <Button Content="✕" Style="{StaticResource ToolbarButtonStyle}" Padding="8,6" Command="{Binding Grid.ClearSearchCommand}" ToolTip="Clear search" />
                            </StackPanel>
                        </Border>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,4" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="FROZEN COLUMNS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="34" Text="{Binding Grid.FrozenColumnCount, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================== Status bar ============================= -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,10">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <ProgressBar Width="220" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding IndexingProgressPercent, Mode=OneWay}"
                                 Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <!-- ============================== Pagination bar ========================== -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,8">
                    <TextBlock Text="{Binding Grid.TotalRowCount, StringFormat='{}{0:N0} record(s)'}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="‹ Previous" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding Grid.PreviousPageCommand}" IsEnabled="{Binding Grid.CanGoToPreviousPage}" />
                        <TextBlock Text="{Binding Grid.PageLabel}" VerticalAlignment="Center" Margin="12,0"
                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Button Content="Next ›" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding Grid.NextPageCommand}" IsEnabled="{Binding Grid.CanGoToNextPage}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================== Grid ==================================== -->
            <DataGrid x:Name="RowsDataGrid"
                      Margin="16"
                      ItemsSource="{Binding Grid.Rows}"
                      SelectedItem="{Binding Grid.SelectedRow, Mode=TwoWay}"
                      SelectionChanged="OnGridSelectionChanged"
                      PreviewMouseLeftButtonDown="OnDataGridPreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="OnDataGridPreviewMouseRightButtonDown"
                      SelectionMode="Extended"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      CanUserSortColumns="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      RowHeight="28"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      AlternationCount="0"
                      HeadersVisibility="Column" />
        </DockPanel>

        <!-- ============================== Column chooser ============================ -->
        <Popup x:Name="ColumnsPopup" PlacementTarget="{Binding ElementName=ColumnsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" MaxHeight="420" Width="240" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="18" ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="COLUMNS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,4,8" />
                    <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                             Text="{Binding Grid.ColumnSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Act on whatever the search box above currently shows — with no search text that's every column. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Select all" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Click="OnSelectAllColumnsClick" />
                        <Button Content="Hide all" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Click="OnHideAllColumnsClick" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Grid.Columns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" Margin="4,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <!-- ============================== Column value filter (Excel-style) ========= -->
        <Popup x:Name="ColumnFilterPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Width="220" MaxHeight="380" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="18" ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock x:Name="ColumnFilterTitle" DockPanel.Dock="Top" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,4,8" TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="ColumnFilterSearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" TextChanged="OnColumnFilterSearchChanged" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Select all" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Click="OnColumnFilterSelectAllClick" />
                        <Button Content="Clear" Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" FontSize="12" Click="OnColumnFilterClearClick" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Style="{StaticResource ToolbarButtonStyle}" Padding="10,5" Click="OnColumnFilterCancelClick" Margin="0,0,8,0" />
                        <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}" Padding="14,5" Click="OnColumnFilterApplyClick" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ColumnFilterValuesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsSelected}" Style="{StaticResource FilterValueCheckBoxStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
